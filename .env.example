# Copia este fichero a .env y ajústalo.

# Carpetas del disco duro: cada una será una biblioteca distinta en Plex/Jellyfin
# (tipo "Series" para SERIES_DIR y tipo "Películas" para MOVIES_DIR). Mejor que no estén
# una dentro de la otra.
SERIES_DIR=/media/series
MOVIES_DIR=/media/movies

# Solo si descargaste con una versión anterior: la carpeta que usabas entonces, para que
# `./animedl.sh rename` mueva esos ficheros a SERIES_DIR / MOVIES_DIR.
# ANIME_DIR=/mnt/disco/anime

# Usuario/grupo dueños de los ficheros (ejecuta `id` para ver los tuyos)
PUID=1000
PGID=1000

TZ=Europe/Madrid

# Cuándo comprobar episodios nuevos (cron). Por defecto: lunes a las 04:00.
ANIMEDL_SCHEDULE=0 4 * * 1
